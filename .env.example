# Database PostgreSQL di questa app (es. un progetto nuovo su https://console.neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/patente_c?sslmode=require"

# Segreto per i token di accesso: una stringa lunga e casuale, diversa per ogni installazione
JWT_SECRET="cambia-questo-segreto"

# Richiesto dalle rotte admin di reimportazione (/api/admin/seed)
SEED_TOKEN="cambia-anche-questo"

# Password dell'utente "admin" (/admin/login): il seed la applica a ogni deploy
ADMIN_PASSWORD="scegline-una-robusta"
