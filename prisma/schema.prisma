generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  password        String?
  isAdmin         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  userSimulations UserSimulation[]
  weakPoints      WeakPoint[]
  focusProgress   FocusProgress[]
  esamiGenerati   Simulation[]
}

/// Gli argomenti dell'esame C/CE, cioè i capitoli del listato ministeriale
/// (data/argomenti.json). L'id dà l'ordine, quello della scheda d'esame.
model Argomento {
  id        Int        @id
  code      String     @unique
  name      String
  /// Quante domande di questo argomento escono nella scheda d'esame
  nEsame    Int
  questions Question[]
}

/// Una domanda d'esame: un'affermazione da segnare vera o falsa.
model Question {
  id            String      @id @default(cuid())
  /// Il codice della domanda nel listato ministeriale: la si ritrova lì così com'è
  code          String      @unique
  argomentoId   Int
  argomento     Argomento   @relation(fields: [argomentoId], references: [id])
  text          String
  risposta      Boolean
  /// Testo comune a più affermazioni, quando il listato le raggruppa sotto una domanda
  questionGroup String?
  /// Figura della domanda, in public/figure/
  image         String?
  answers       Answer[]
  weakPoints    WeakPoint[]
}

model Simulation {
  id              String           @id @default(cuid())
  number          Int              @unique
  /// JSON: gli id delle domande, nell'ordine in cui escono (40)
  questions       String
  titolo          String?
  /// "simulazione" per quelle fisse (dall'archivio o create dall'admin),
  /// "reale" per gli esami generati (vedi lib/esame-generato.ts).
  tipo            String           @default("simulazione")
  /// Esame composto per un utente (vedi lib/esame-generato.ts). Sta qui, e
  /// non in una tabella sua, perché così pagina d'esame, risposte,
  /// completamento e report non cambiano.
  generata        Boolean          @default(false)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  userSimulations UserSimulation[]
}

model UserSimulation {
  id              String            @id @default(cuid())
  userId          String
  simulationId    String
  status          String            @default("IN_PROGRESS")
  /// Domande giuste
  score           Int?
  /// Domande sbagliate o lasciate in bianco
  errors          Int?
  passed          Boolean?
  timeElapsed     Int?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  questionOrder   String?
  user            User              @relation(fields: [userId], references: [id])
  simulation      Simulation        @relation(fields: [simulationId], references: [id])
  answers         Answer[]
  argomentoResults ArgomentoResult[]
}

model Answer {
  id               String         @id @default(cuid())
  userSimulationId String
  questionId       String
  userAnswer       Boolean?
  isCorrect        Boolean?
  answeredAt       DateTime?
  // La correzione è stata mostrata (modalità Studio): da qui la risposta non si cambia più
  rivelata         Boolean        @default(false)
  userSimulation   UserSimulation @relation(fields: [userSimulationId], references: [id])
  question         Question       @relation(fields: [questionId], references: [id])

  @@unique([userSimulationId, questionId])
}

/// Risposte giuste per argomento in una simulazione completata: le legge il
/// Riepilogo per dire dove si fa più fatica.
model ArgomentoResult {
  id               String         @id @default(cuid())
  userSimulationId String
  argomentoCode    String
  correct          Int
  total            Int
  accuracy         Float
  userSimulation   UserSimulation @relation(fields: [userSimulationId], references: [id])
}

model WeakPoint {
  id                 String   @id @default(cuid())
  userId             String
  questionId         String
  consecutiveCorrect Int      @default(0)
  totalAttempts      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
  question           Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

/// Avanzamento nello Studio (Focus), un record per utente e argomento.
/// Permette di riprendere da dove si era rimasti invece di ripartire da capo.
model FocusProgress {
  id            String   @id @default(cuid())
  userId        String
  argomentoCode String
  answers       String   @default("{}") // JSON: { questionId: boolean }
  currentIdx    Int      @default(0) // indice della domanda mostrata
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, argomentoCode])
}
